{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "SUPABASE_URL": "@supabase_url",
    "SUPABASE_ANON_KEY": "@supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@supabase_service_role_key",
    "SMS_GATE_SERVER": "@sms_gate_server",
    "SMS_GATE_USERNAME": "@sms_gate_username",
    "SMS_GATE_PASSWORD": "@sms_gate_password",
    "SMS_GATE_DEVICE_ID": "@sms_gate_device_id"
  }
}